generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  super_admin
  admin
  va
}

enum UserStatus {
  active
  inactive
}

/**
 * Coarse grouping for activity_log rows, additive alongside the existing
 * `type` (auto|manual) column — lets the log UI filter "what kind of thing
 * happened" (auth, profile, user management, ...) independent of whether it
 * was a system or human action. Existing rows are backfilled to `patient`.
 */
enum ActivityCategory {
  auth
  profile
  patient
  appointment
  user_management
  report
  system
  messaging
}

enum ChecklistStatus {
  required
  optional
}

enum EligibilityStatus {
  not_checked
  eligible
  not_eligible
}

enum PatientStatus {
  active
  completed
  cancelled
}

enum VisitStatus {
  not_visited
  arrived
  no_show
  rescheduled
}

enum CrmPermission {
  read
  write
  both
}

enum CrmConnectionStatus {
  connected
  disconnected
}

/**
 * "dm" is the only kind Phase 1 creates. "group" is defined now so Phase 2
 * (Link Internal Board group chats) is an additive change — no migration to
 * widen this enum later.
 */
enum InternalConversationType {
  dm
  group
}

enum InternalAttachmentType {
  image
  video
  audio
  file
}

model Stage {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  hint      String?
  sortOrder Int      @default(0) @map("sort_order")
  isFinal   Boolean  @default(false) @map("is_final")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  checklistItems ChecklistItem[]
  patients       Patient[]

  @@index([sortOrder])
  @@map("stages")
}

model User {
  id                   String     @id @default(uuid())
  name                 String
  email                String     @unique
  passwordHash         String     @map("password_hash")
  role                 UserRole   @default(va)
  status               UserStatus @default(active)
  shift                String?
  avatar               String?    @map("avatar_url")
  passwordResetToken   String?    @map("password_reset_token")
  passwordResetExpires DateTime?  @map("password_reset_expires")
  lastLoginAt          DateTime?  @map("last_login_at")
  createdById          String?    @map("created_by")
  createdAt            DateTime   @default(now()) @map("created_at")

  assignedPatients      Patient[]        @relation("PatientAssignedTo")
  createdPatients       Patient[]        @relation("PatientCreatedBy")
  flaggedPatients       Patient[]        @relation("PatientFlaggedBy")
  flagClearedPatients   Patient[]        @relation("PatientFlagClearedBy")
  flagsRaised           PatientFlag[]    @relation("FlagRaisedBy")
  flagsCleared          PatientFlag[]    @relation("FlagClearedBy")
  notesCreated          PatientNote[]    @relation("PatientNotesCreatedBy")
  updatedPatients       Patient[]        @relation("PatientUpdatedBy")
  cancelledPatients     Patient[]        @relation("PatientCancelledBy")
  privateLockedPatients Patient[]        @relation("PatientPrivateLockedBy")
  refreshTokens         RefreshToken[]
  activityLogs          ActivityLog[]    @relation("ActivityLogActor")
  importBatches         ImportBatch[]    @relation("ImportBatchImportedBy")
  crmIntegrations       CrmIntegration[]
  appSettingsUpdated    AppSetting[]
  sentSmsMessages       SmsMessage[]

  // Link Internal Board (VA/Admin staff chat) — fully separate from the
  // patient-SMS models above; no FK crosses between the two feature areas.
  internalConversationsCreated InternalConversation[]            @relation("InternalConversationCreatedBy")
  internalParticipations       InternalConversationParticipant[]
  internalMessagesSent         InternalMessage[]

  createdByUser User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers  User[] @relation("UserCreatedBy")

  @@map("users")
}

model Patient {
  id                     String            @id @default(uuid())
  // firstName/lastName are the source of truth — the legacy single `name`
  // column was dropped (migration backfilled first/last from it). The API
  // still returns a computed `name` (full name) so existing display code
  // keeps working; it is never stored.
  firstName              String            @map("first_name")
  lastName               String?           @map("last_name")
  location               String?
  email                  String?
  phone                  String?
  dateOfBirth            DateTime?         @map("date_of_birth") @db.Date
  stage                  String            @default("onboarding")
  stageRef               Stage?            @relation(fields: [stage], references: [key], onDelete: Restrict)
  status                 PatientStatus     @default(active)
  visitStatus            VisitStatus       @default(not_visited) @map("visit_status")
  assignedTo             String?           @map("assigned_to")
  notes                  String?
  checklistState         Json              @default("{}") @map("checklist_state")
  isFlagged              Boolean           @default(false) @map("is_flagged")
  flagReason             String?           @map("flag_reason")
  flaggedById            String?           @map("flagged_by")
  flaggedAt              DateTime?         @map("flagged_at")
  flagClearedReason      String?           @map("flag_cleared_reason")
  flagClearedById        String?           @map("flag_cleared_by")
  flagClearedAt          DateTime?         @map("flag_cleared_at")
  completedAt            DateTime?         @map("completed_at")
  cancelledAt            DateTime?         @map("cancelled_at")
  cancelledById          String?           @map("cancelled_by")
  cancelledReason        String?           @map("cancelled_reason")
  source                 String            @default("manual")
  createdById            String?           @map("created_by")
  bookingPlatform        String?           @map("booking_platform")
  appointmentDatetime    DateTime?         @map("appointment_datetime") @db.Timestamptz(3)
  // End of the booked slot. Klarity sends a real endAt; other sources leave it
  // null and the calendar falls back to its own default slot length.
  appointmentEndDatetime DateTime?         @map("appointment_end_datetime") @db.Timestamptz(3)
  // Klarity clientId — identifies the same PERSON across multiple bookings, so
  // a second appointment attaches to this existing patient instead of creating
  // a duplicate. Null for manual and email-parsed intake.
  externalPatientId      String?           @map("external_patient_id")
  // Denormalized copy of the most recent Klarity appointment id, for quick
  // lookups. The authoritative, uniquely-constrained record of every
  // appointment (past and upcoming) is AppointmentHistory below — a patient
  // can have many appointments, so this column is NOT unique.
  externalAppointmentId  String?           @map("external_appointment_id")
  problemDescription     String?           @map("problem_description")
  paymentMethod          String?           @map("payment_method")
  insuranceProvider      String?           @map("insurance_provider")
  paymentDetails         Json?             @map("payment_details")
  copayAmount            Decimal?          @map("copay_amount") @db.Decimal(10, 2)
  amountPaid             Decimal?          @map("amount_paid") @db.Decimal(10, 2)
  eligibilityStatus      EligibilityStatus @default(not_checked) @map("eligibility_status")
  eligibilityCheckedAt   DateTime?         @map("eligibility_checked_at")
  eligibilityDetails     Json?             @map("eligibility_details")
  eligibilityReason      String?           @map("eligibility_reason")
  isPrivate              Boolean           @default(false) @map("is_private")
  privateLockedById      String?           @map("private_locked_by")
  privateLockedAt        DateTime?         @map("private_locked_at")
  importBatchId          String?           @map("import_batch_id")
  updatedAt              DateTime          @default(now()) @updatedAt @map("updated_at")
  updatedById            String?           @map("updated_by")
  createdAt              DateTime          @default(now()) @map("created_at")

  assignedUser        User?        @relation("PatientAssignedTo", fields: [assignedTo], references: [id])
  createdByUser       User?        @relation("PatientCreatedBy", fields: [createdById], references: [id])
  flaggedByUser       User?        @relation("PatientFlaggedBy", fields: [flaggedById], references: [id])
  flagClearedByUser   User?        @relation("PatientFlagClearedBy", fields: [flagClearedById], references: [id])
  updatedByUser       User?        @relation("PatientUpdatedBy", fields: [updatedById], references: [id])
  cancelledByUser     User?        @relation("PatientCancelledBy", fields: [cancelledById], references: [id])
  privateLockedByUser User?        @relation("PatientPrivateLockedBy", fields: [privateLockedById], references: [id])
  importBatch         ImportBatch? @relation(fields: [importBatchId], references: [id])

  activityLogs       ActivityLog[]
  flags              PatientFlag[]        @relation("PatientFlags")
  patientNotes       PatientNote[]        @relation("PatientNotes")
  smsConversations   SmsConversation[]
  appointmentHistory AppointmentHistory[]

  @@index([stage])
  @@index([isFlagged])
  @@index([updatedAt])
  @@index([status])
  @@index([appointmentDatetime])
  @@index([externalPatientId])
  @@index([isPrivate])
  @@map("patients")
}

/**
 * Full flag history for a patient (multiple flags allowed). The patient row
 * keeps its single "currently flagged" snapshot (isFlagged/flagReason) so the
 * board badge and stale logic stay cheap — each raise/clear also writes a row
 * here for the modal's flag history (latest flag + count + view-all list).
 */
/**
 * One appointment's lifecycle state — see AppointmentHistory.
 */
enum AppointmentEventStatus {
  scheduled
  rescheduled
  canceled
  no_show
  completed
}

/**
 * Append-only appointment record. A patient can book more than one
 * appointment over time (a follow-up, a re-booking after a no-show, ...) —
 * before this table existed, a second Klarity booking either overwrote
 * `patients.appointment_datetime` with no trace of the first, or was rejected
 * outright as a duplicate patient. Every booking now gets its own row here
 * instead, keyed by `externalAppointmentId` so Klarity's later events for that
 * SAME appointment (reschedule / cancel / no-show / completed) update this row
 * in place rather than creating new ones — a genuinely NEW appointment
 * (different externalAppointmentId) always gets its own new row.
 * `patients.appointment_datetime` / `appointment_end_datetime` stay as a
 * denormalized "next appointment" snapshot for the board and card — recomputed
 * from these rows after every write — so existing card/board code needs no
 * changes to keep working.
 */
model AppointmentHistory {
  id        String  @id @default(uuid())
  patientId String  @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  appointmentDatetime    DateTime  @map("appointment_datetime") @db.Timestamptz(3)
  appointmentEndDatetime DateTime? @map("appointment_end_datetime") @db.Timestamptz(3)
  // What the date/time was immediately before the most recent reschedule —
  // null until the first reschedule. Lets the history tab show "moved from
  // Sep 5 to Sep 6" without a separate full event-log table.
  previousDatetime       DateTime? @map("previous_datetime") @db.Timestamptz(3)

  status AppointmentEventStatus @default(scheduled)

  // Vendor-side identity. Unique: this is what makes a reschedule/cancel/
  // no-show/completed event for the SAME Klarity appointment update this row
  // instead of creating a duplicate. Null for a manually-entered appointment.
  externalAppointmentId String? @unique @map("external_appointment_id")

  source        String  @default("klarity") @map("source")
  // Raw Klarity eventType of the most recent update (e.g.
  // "appointment.rescheduled") — kept for debugging, not used by any UI logic.
  lastEventType String? @map("last_event_type")

  // Practitioner seeing the patient, e.g. from Klarity's providerFirstName/
  // providerLastName.
  providerName String? @map("provider_name")
  // Who is running/hosting this specific appointment (e.g. the staff member
  // handling a video call). Optional — Klarity does not send this today; the
  // column exists for a manual entry or a future Klarity field to fill in.
  hostName     String? @map("host_name")

  serviceType String? @map("service_type")
  // Operational reason for the visit only, never clinical detail — same
  // constraint as Patient.problemDescription.
  reason      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([appointmentDatetime])
  @@map("appointment_history")
}

/**
 * Full note history for a patient (multiple notes allowed, newest first).
 * Mirrors the PatientFlag pattern — each note is its own row so the modal can
 * render a list instead of one overwritten scalar value. The legacy
 * `patients.notes` scalar is kept for backward compatibility with old rows
 * but no longer written by the app; migration backfills it into this table.
 */
model PatientNote {
  id          String   @id @default(uuid())
  patientId   String   @map("patient_id")
  content     String
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  patient       Patient @relation("PatientNotes", fields: [patientId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("PatientNotesCreatedBy", fields: [createdById], references: [id])

  @@index([patientId])
  @@map("patient_notes")
}

model PatientFlag {
  id            String    @id @default(uuid())
  patientId     String    @map("patient_id")
  stage         String
  type          String    @default("negative")
  reason        String
  flaggedById   String    @map("flagged_by")
  clearedById   String?   @map("cleared_by")
  clearedReason String?   @map("cleared_reason")
  clearedAt     DateTime? @map("cleared_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  patient       Patient @relation("PatientFlags", fields: [patientId], references: [id], onDelete: Cascade)
  flaggedByUser User    @relation("FlagRaisedBy", fields: [flaggedById], references: [id])
  clearedByUser User?   @relation("FlagClearedBy", fields: [clearedById], references: [id])

  @@index([patientId])
  @@index([stage])
  @@map("patient_flags")
}

model ActivityLog {
  id         String           @id @default(uuid())
  /**
   * Nullable — patient-scoped events (the original use case) still set this;
   * system-wide events (login, user management, exports, ...) leave it null.
   * onDelete SetNull (was Cascade) so audit history outlives a deleted patient.
   */
  patientId  String?          @map("patient_id")
  author     String
  message    String
  /**
   * Kept as-is for backward compatibility with existing rows/queries: auto|manual.
   */
  type       String
  actorId    String?          @map("actor_id")
  action     String?          @map("action")
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  prevValue  Json?            @map("prev_value")
  newValue   Json?            @map("new_value")
  metadata   Json?            @default("{}")
  /**
   * New, additive grouping — see ActivityCategory. Existing rows backfilled to `patient`.
   */
  category   ActivityCategory @default(patient)
  /**
   * Denormalised actor snapshot — survives the actor's user row being deleted.
   */
  actorRole  String?          @map("actor_role")
  actorName  String?          @map("actor_name")
  ipAddress  String?          @map("ip_address")
  userAgent  String?          @map("user_agent")
  createdAt  DateTime         @default(now()) @map("created_at")

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  actor   User?    @relation("ActivityLogActor", fields: [actorId], references: [id])

  @@index([patientId])
  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([entityId])
  @@index([category])
  @@map("activity_log")
}

model ImportBatch {
  id             String    @id @default(uuid())
  fileName       String    @map("file_name")
  fileType       String    @map("file_type")
  totalRows      Int       @map("total_rows")
  successCount   Int       @default(0) @map("success_count")
  failCount      Int       @default(0) @map("fail_count")
  duplicateCount Int       @default(0) @map("duplicate_count")
  status         String    @default("completed")
  errorDetails   Json?     @default("[]") @map("error_details")
  importedById   String    @map("imported_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  importedByUser User      @relation("ImportBatchImportedBy", fields: [importedById], references: [id])
  patients       Patient[]

  @@index([importedById])
  @@index([createdAt])
  @@map("import_batches")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ChecklistItem {
  id          String          @id @default(uuid())
  stage       String
  stageRef    Stage           @relation(fields: [stage], references: [key], onDelete: Restrict)
  label       String
  description String?
  status      ChecklistStatus @default(required)
  isDefault   Boolean         @default(false) @map("is_default")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([stage, label])
  @@index([stage])
  @@map("checklist_items")
}

model EligibilityRule {
  id        String   @id @default(uuid())
  label     String
  field     String
  operator  String
  value     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("eligibility_rules")
}

/**
 * Admin-only CRM connection settings (config-crm page). The "connect" action
 * simulates a successful handshake rather than calling a real third-party API
 * — no real Optimantra/GoHighLevel credentials exist yet. Only a masked
 * preview of the key is stored, never the raw value.
 */
model CrmIntegration {
  id            String              @id @default(uuid())
  provider      String
  apiKeyLast4   String?             @map("api_key_last4")
  permission    CrmPermission       @default(read)
  status        CrmConnectionStatus @default(disconnected)
  connectedById String?             @map("connected_by")
  connectedAt   DateTime?           @map("connected_at")
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  connectedByUser User? @relation(fields: [connectedById], references: [id])

  @@map("crm_integrations")
}

enum WebhookLogDirection {
  request
  response
}

/**
 * Durable record of every webhook hit (Optimantra's /intake and Klarity's
 * /intake/klarity) — the raw request body exactly as received, and the
 * response sent back. Written from webhookPayloadLogger in
 * @/utils/webhookLogger.ts.
 * Lives in Postgres rather than a log file specifically because this backend
 * deploys to Vercel as a serverless function — Vercel's filesystem is
 * ephemeral/read-only outside `/tmp` and not shared across invocations, so a
 * file written during one request is gone (or never written at all) by the
 * next. A DB row survives every deploy and is queryable the same way in dev
 * and production.
 * Deliberately has NO foreign key to Patient: a rejected webhook (bad auth,
 * failed validation) never creates a patient at all, and this table's whole
 * purpose is to capture those cases too — a required relation to a row that
 * may not exist would defeat that.
 */
model WebhookLog {
  id         String              @id @default(uuid())
  source     String
  direction  WebhookLogDirection
  method     String
  path       String
  ip         String?
  statusCode Int?                @map("status_code")
  durationMs Int?                @map("duration_ms")
  payload    Json
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([source])
  @@index([createdAt])
  @@map("webhook_logs")
}

/**
 * Application-wide settings (key-value pairs).
 * Used for configurable thresholds like stale card detection time.
 * Updated only by admin users via the settings API.
 */
model AppSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  updatedByUser User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

/**
 * One row per distinct SMS phone number talking to the clinic's Quo business
 * number - not per patient, since an unmatched number (wrong number, referral,
 * spam) still needs a home so its messages are never silently dropped. Linked
 * to a Patient only when the phone number matches one on file.
 */
model SmsConversation {
  id                 String    @id @default(uuid())
  phoneNumber        String    @unique @map("phone_number") // E.164 normalized
  patientId          String?   @map("patient_id")
  /// Which Quo business number this thread belongs to (e.g. "PN3lxEXr7a").
  /// Nullable: rows created before multi-number support have no value and
  /// stay visible under the inbox's "All numbers" view.
  quoPhoneNumberId   String?   @map("quo_phone_number_id")
  quoContactId       String?   @map("quo_contact_id")
  quoContactName     String?   @map("quo_contact_name")
  lastMessageAt      DateTime? @map("last_message_at")
  lastMessagePreview String?   @map("last_message_preview")
  unreadCount        Int       @default(0) @map("unread_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  patient  Patient?     @relation(fields: [patientId], references: [id])
  messages SmsMessage[]
  callLogs SmsCallLog[]

  @@index([patientId])
  @@index([lastMessageAt])
  @@index([quoPhoneNumberId])
  @@map("sms_conversations")
}

/**
 * Individual inbound/outbound SMS within a conversation thread. Outbound
 * messages record `sentById` so the UI can attribute "who sent this" across
 * shift-sharing VAs, per the same audit standard as the rest of the app.
 */
model SmsMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  direction      String // "inbound" | "outbound"
  body           String
  status         String   @default("sent") // sent | delivered | failed | received
  quoMessageId   String?  @unique @map("quo_message_id")
  sentById       String?  @map("sent_by_id") // VA/admin user id, outbound only
  errorMessage   String?  @map("error_message")
  /// Inbound attachments from Quo, e.g. [{ "type": "image/jpeg", "url": "https://..." }].
  /// Quo has no send-MMS endpoint, so this is only ever populated on inbound
  /// messages, never something this app writes on an outbound send.
  media          Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation SmsConversation @relation(fields: [conversationId], references: [id])
  sentByUser   User?           @relation(fields: [sentById], references: [id])

  @@index([conversationId])
  @@index([createdAt])
  @@map("sms_messages")
}

/**
 * Call history synced from Quo's GET /v1/calls, merged into the thread
 * timeline alongside SmsMessage on the frontend (chronological, by
 * createdAt). Read-only from our side - calls are placed here only by
 * syncing from Quo, never created directly by this app.
 */
model SmsCallLog {
  id              String   @id @default(uuid())
  conversationId  String   @map("conversation_id")
  quoCallId       String   @unique @map("quo_call_id")
  direction       String // "incoming" | "outgoing" (Quo's own call-direction values)
  status          String // Quo's raw call status: completed | missed | no-answer | busy | ...
  durationSeconds Int?     @map("duration_seconds")
  createdAt       DateTime @map("created_at")

  conversation SmsConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
  @@map("sms_call_logs")
}

// =============================================================================
// Link Internal Board — internal staff (VA/Admin) chat.
//
// Deliberately separate from the SmsConversation/SmsMessage models above:
// different feature, different audience (staff talking to each other, not
// patient SMS), different lifecycle. No foreign key ever crosses between
// them. Shares only generic infra (User, Pusher client, Cloudinary) with the
// rest of the app, same as any two unrelated features would.
// =============================================================================

/**
 * One row per conversation — a 1:1 DM in Phase 1, `type: group` reserved for
 * Phase 2. `name`/`avatarUrl` are null for a DM (its "identity" is just the
 * other participant); Phase 2 group chats set them.
 */
model InternalConversation {
  id                 String                   @id @default(uuid())
  type               InternalConversationType @default(dm)
  name               String?
  avatarUrl          String?                  @map("avatar_url")
  /**
   * Phase 2 — the two participant user IDs, sorted and joined ("id1:id2"),
   * set only for `type: dm`. A DB-level unique constraint (not just an
   * application-level findFirst-then-create check) so two concurrent
   * "send my first message to this person" requests can never race into two
   * separate DM threads: the loser of the race hits a unique-violation and
   * falls back to the winner's row instead. Null for groups (Phase 3+),
   * which have no single fixed pair.
   */
  dmPairKey          String?                  @unique @map("dm_pair_key")
  createdById        String?                  @map("created_by")
  lastMessageAt      DateTime?                @map("last_message_at")
  lastMessagePreview String?                  @map("last_message_preview")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at")

  createdByUser User?                             @relation("InternalConversationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  participants  InternalConversationParticipant[]
  messages      InternalMessage[]

  @@index([lastMessageAt])
  @@map("internal_conversations")
}

/**
 * Membership row — also carries `lastReadAt` so unread counts are a simple
 * "messages after my lastReadAt" query, no separate read-receipt table
 * needed for Phase 1.
 */
model InternalConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  lastReadAt     DateTime? @map("last_read_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")

  conversation InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("internal_conversation_participants")
}

/**
 * A single chat message. `body` is nullable — a message can be attachment-only
 * (e.g. just a photo, no caption), matching iMessage/WhatsApp conventions.
 */
model InternalMessage {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  body           String?
  /**
   * Phase 2 — reply-to. Nullable self-relation; SetNull on delete so
   * replying to a message that later gets deleted doesn't cascade-delete
   * the reply itself, it just orphans the quote reference.
   */
  replyToId      String?   @map("reply_to_id")
  editedAt       DateTime? @map("edited_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                 @relation(fields: [senderId], references: [id])
  attachments  InternalAttachment[]
  replyTo      InternalMessage?     @relation("InternalMessageReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      InternalMessage[]    @relation("InternalMessageReplyTo")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@map("internal_messages")
}

/**
 * One row per uploaded file on a message. Media itself lives on Cloudinary
 * (folder "ech-pipeline/internal-board") — only the resulting URL + display
 * metadata is stored here, same "never store the binary ourselves" approach
 * as everything else in this app that touches Cloudinary.
 */
model InternalAttachment {
  id              String                 @id @default(uuid())
  messageId       String                 @map("message_id")
  type            InternalAttachmentType
  url             String
  thumbnailUrl    String?                @map("thumbnail_url")
  fileName        String                 @map("file_name")
  mimeType        String                 @map("mime_type")
  sizeBytes       Int                    @map("size_bytes")
  width           Int?
  height          Int?
  durationSeconds Int?                   @map("duration_seconds")
  createdAt       DateTime               @default(now()) @map("created_at")

  message InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("internal_attachments")
}
