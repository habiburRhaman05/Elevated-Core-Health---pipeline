# Environment Configuration
NODE_ENV="development"
PORT="8080"
HOST="localhost"
CORS_ORIGIN="http://localhost:5173"

# Rate limiting
COMMON_RATE_LIMIT_MAX_REQUESTS="1000"
COMMON_RATE_LIMIT_WINDOW_MS="1000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ech_pipeline?schema=public"

# JWT secrets — generate with: openssl rand -base64 32
JWT_ACCESS_SECRET="replace-with-access-secret-min-16-chars"
JWT_REFRESH_SECRET="replace-with-refresh-secret-min-16-chars"

# Webhook shared secret (Make.com → POST /api/patients/intake)
WEBHOOK_SECRET="replace-with-webhook-secret-min-16-chars"

# Password Vault at-rest encryption key — exactly 32 bytes, hex-encoded (64
# hex chars). Generate with: openssl rand -hex 32
# Rotating this makes every already-stored password unreadable — back it up
# like a database credential, don't regenerate it casually.
PASSWORD_VAULT_ENCRYPTION_KEY="replace-with-64-hex-chars-from-openssl-rand--hex-32"

# Groq (AI name-extraction fallback for the Grow Therapy .ics sync) — optional.
# Used only when a calendar event's description has no explicit "Patient:/Client
# Name:" label to extract the full patient name from; the sync falls back to the
# title initials when unset or when the model call fails.
GROQ_API_KEY=""
# Model id — llama3-8b-8192 has been decommissioned by Groq; this is the current
# cheap production default. Override to any live id (see console.groq.com/docs/models).
GROQ_MODEL="openai/gpt-oss-20b"

# Resend (transactional email) — optional; notification endpoints are no-ops without it
RESEND_API_KEY=""

# Cloudinary (profile avatar uploads) — optional; POST /api/auth/profile/avatar
# returns a clear "not configured" error without them. Get these from your
# Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Quo (OpenPhone) SMS — optional; every messaging endpoint returns a clear
# "not configured" error (never a silent no-op) without these.
# API key from the Quo dashboard → Settings → API Keys.
QUO_API_KEY=""
QUO_WEBHOOK_SIGNING_SECRET=""
# Note: the business numbers themselves are not configured here. They're
# discovered at runtime from Quo's GET /v1/phone-numbers and filtered to the
# ones allowed to send US SMS, so adding a number needs no redeploy.
