# Environment Configuration
NODE_ENV="development"
PORT="8080"
HOST="localhost"
CORS_ORIGIN="http://localhost:5173"

# Rate limiting
COMMON_RATE_LIMIT_MAX_REQUESTS="1000"
COMMON_RATE_LIMIT_WINDOW_MS="1000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ech_pipeline?schema=public"

# JWT secrets — generate with: openssl rand -base64 32
JWT_ACCESS_SECRET="replace-with-access-secret-min-16-chars"
JWT_REFRESH_SECRET="replace-with-refresh-secret-min-16-chars"

# Webhook shared secret (Make.com → POST /api/patients/intake)
WEBHOOK_SECRET="replace-with-webhook-secret-min-16-chars"

# Resend (transactional email) — optional; notification endpoints are no-ops without it
RESEND_API_KEY=""

# Cloudinary (profile avatar uploads) — optional; POST /api/auth/profile/avatar
# returns a clear "not configured" error without them. Get these from your
# Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Quo (OpenPhone) SMS — optional; every messaging endpoint returns a clear
# "not configured" error (never a silent no-op) without these.
# API key from the Quo dashboard → Settings → API Keys.
QUO_API_KEY=""
# Verifies inbound webhook requests to POST /api/webhooks/quo are really from
# Quo (signature or shared-secret check — see lib/quo.ts) before any payload
# is processed. Treat with the same care as WEBHOOK_SECRET above.
QUO_WEBHOOK_SIGNING_SECRET=""
# The clinic's single Quo business number (E.164, e.g. "+15551234567") and
# the Quo userId that owns it — both required to send outbound SMS. Find
# these by running listPhoneNumbers() from lib/quo.ts once QUO_API_KEY is
# set (see backend/README.md).
QUO_FROM_NUMBER=""
QUO_USER_ID=""
